# ---------------------------------------------------------------
# Yasmeen World - environment configuration
# Copy this file to .env.local and adjust the values.
# ---------------------------------------------------------------

# Public address of the site (used in emails, sitemap and canonical URLs).
SITE_URL=http://localhost:3000

# MySQL / MariaDB (XAMPP defaults shown). For production create a dedicated
# database user instead of using root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=yasmeenworld

# Where uploaded images are stored (relative to the project or absolute).
UPLOAD_DIR=./storage/uploads

# Store time zone (Jordan is UTC+3 all year).
STORE_TIMEZONE=Asia/Amman

# --- Email (optional) -------------------------------------------
# Leave SMTP_HOST empty to disable email. Orders still work; the store
# records "not configured" in the email_outbox table and never claims
# an email was sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Yasmeen World <no-reply@example.com>"
